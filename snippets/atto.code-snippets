{
  "Atto function (preview)": {
    "prefix": "atto-fnc",
    "description": "End-delimited Atto function scaffold (preview; compiler support varies)",
    "body": [
      "fnc ${1:name}(${2}): ${3:int} as",
      "  ${0:return 0;}",
      "end"
    ]
  },
  "Atto actor (preview)": {
    "prefix": "atto-actor",
    "description": "Atto actor declaration scaffold (preview)",
    "body": [
      "define actor ${1:Worker} as",
      "  ${0}",
      "end"
    ]
  },
  "Atto conditional": {
    "prefix": "atto-if",
    "description": "if/then/fi statement",
    "body": [
      "if ${1:condition} then",
      "  ${0}",
      "fi"
    ]
  },
  "Atto while loop": {
    "prefix": "atto-while",
    "description": "while/do/done loop",
    "body": [
      "while ${1:condition} do",
      "  ${0}",
      "done"
    ]
  },
  "Atto match expression": {
    "prefix": "atto-match",
    "description": "match/over/end scaffold; check arms against compiler target",
    "body": [
      "match ${1:value} over",
      "  ${0}",
      "end"
    ]
  },
  "Atto Symbol": {
    "prefix": "atto-symbol",
    "description": "Symbol literal with # prefix",
    "body": "#${1:ready}"
  },
  "Atto functional pipeline": {
    "prefix": "atto-pipe",
    "description": "Functional pipeline, distinct from actor pipe keyword",
    "body": "${1:value} |> ${2:transform}"
  },
  "Atto instance method (preview)": {
    "prefix": "atto-mtd",
    "description": "Explicit instance method scaffold inside a nominal declaration; compiler support varies",
    "body": [
      "mtd ${1:name}(${2}): ${3:int} {",
      "  ${0:return 0;}",
      "}"
    ]
  }
}
